{
  "name": "street-racer-backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/src/main.js",
    "start:dev": "node --watch --require ts-node/register src/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node src/seed.ts",
    "db:local": "node scripts/local-db.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9"
  },
  "overrides": {
    "js-yaml": "^5.4.3",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
